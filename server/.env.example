# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000

# Runtime mode. The cloud uses "production."
# NODE_ENV=development

# First admin password for the seed. Required when NODE_ENV=production.
# ADMIN_PASSWORD=change-me

# Demo users and sample tickets. Default: on locally, off in production.
# SEED_DEMO_DATA=false
# DEMO_USER_PASSWORD=change-me

# Allowed web origins, comma-separated (optional).
# CORS_ORIGIN=http://localhost:5173

# Old x-requester-id header for legacy tests. Never enable it in the cloud.
# ALLOW_LEGACY_REQUESTER_HEADER=false
