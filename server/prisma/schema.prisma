// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW          // ticket ถูกสร้างใหม่ (default)
  OPEN         // ticket ถูกเปิดและรอดำเนินการ
  IN_PROGRESS  // ticket อยู่ระหว่างดำเนินการ
  RESOLVED     // ticket ได้รับการแก้ไขแล้ว
  CLOSED       // ticket ถูกปิด
}

// ---------------------------------------------------------------------------
// Reference Data
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets   Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// RequesterUser — temporary dev-only model (BR-18: design for Lab 3 migration)
// When real auth arrives in Lab 3, replace this model with a proper User model.
// FK references in Ticket use requesterId (Int) so that swapping the target
// table requires only a schema change, not a data migration.
// ---------------------------------------------------------------------------

model RequesterUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// Ticket
// ---------------------------------------------------------------------------

model Ticket {
  id                Int          @id @default(autoincrement())
  ticketNumber      String       @unique                    // generated by backend (BR-01)
  status            TicketStatus @default(NEW)              // always starts as NEW (BR-01)
  requestedPriority Priority

  summary           String       @db.VarChar(200)           // max 200 chars (BR-06)
  description       String       @db.VarChar(2000)          // max 2000 chars (BR-06)

  // Foreign keys
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  requester         RequesterUser @relation(fields: [requesterId], references: [id])
  category          Category      @relation(fields: [categoryId], references: [id])
  relatedSystem     RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  attachments       Attachment[]

  // Indexes for common query patterns (BR-10)
  @@index([requesterId])
  @@index([status])
  @@index([ticketNumber])
}

// ---------------------------------------------------------------------------
// Attachment — soft-delete only, never physically deleted (BR-13)
// ---------------------------------------------------------------------------

model Attachment {
  id               Int       @id @default(autoincrement())

  // File metadata
  originalFilename String                                   // original name kept as metadata (BR-15)
  storedFilename   String    @unique                        // UUID-based server filename (BR-15)
  mimeType         String
  size             Int                                      // bytes

  // Soft-remove fields (BR-13)
  isRemoved        Boolean   @default(false)
  removedReason    String?   @db.VarChar(500)               // max 500 chars (BR-13)
  removedAt        DateTime?

  uploadedAt       DateTime  @default(now())

  // Foreign key
  ticketId         Int
  ticket           Ticket    @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}
