// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW                   // ticket ถูกสร้างใหม่ (default)
  OPEN                  // ticket ถูกเปิดและรอดำเนินการ
  IN_PROGRESS           // ticket อยู่ระหว่างดำเนินการ
  WAITING_FOR_REQUESTER // รอ Requester ตอบกลับ
  RESOLVED              // ticket ได้รับการแก้ไขแล้ว
  CLOSED                // ticket ถูกปิด
  REOPENED              // ticket ถูกเปิดใหม่
  CANCELLED             // ticket ถูกยกเลิก (terminal)
}

// ---------------------------------------------------------------------------
// Reference Data
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets   Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// User — replaces RequesterUser from Lab 2 (BR-03, FR-06)
// ---------------------------------------------------------------------------

model User {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(200)
  email              String   @unique
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  tickets            Ticket[] @relation("RequesterTickets")
  ownedTickets       Ticket[] @relation("OwnerTickets")
  comments           Comment[]
  internalNotes      InternalNote[]

  @@index([email])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Ticket
// ---------------------------------------------------------------------------

model Ticket {
  id                        Int          @id @default(autoincrement())
  ticketNumber              String       @unique                      // generated by backend (BR-01)
  status                    TicketStatus @default(NEW)                // always starts as NEW (BR-01)
  requestedPriority         Priority
  itPriority                Priority                                  // defaults to requestedPriority on create (BR-13)

  summary                   String       @db.VarChar(200)             // max 200 chars
  description               String       @db.VarChar(2000)            // max 2000 chars

  requesterIndicatedResolved Boolean     @default(false)              // Requester "problem appears resolved" flag (FR-12)

  // Foreign keys
  requesterId               Int
  categoryId                Int
  relatedSystemId           Int
  ownerId                   Int?                                      // nullable — unassigned initially (BR-12)

  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  // Relations
  requester                 User         @relation("RequesterTickets", fields: [requesterId], references: [id])
  owner                     User?        @relation("OwnerTickets", fields: [ownerId], references: [id])
  category                  Category     @relation(fields: [categoryId], references: [id])
  relatedSystem             RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  attachments               Attachment[]
  comments                  Comment[]
  internalNotes             InternalNote[]

  // Indexes for common query patterns
  @@index([requesterId])
  @@index([ownerId])
  @@index([status])
  @@index([ticketNumber])
}

// ---------------------------------------------------------------------------
// Attachment — soft-delete only, never physically deleted
// ---------------------------------------------------------------------------

model Attachment {
  id               Int       @id @default(autoincrement())

  // File metadata
  originalFilename String                                             // original name kept as metadata
  storedFilename   String    @unique                                  // UUID-based server filename
  mimeType         String
  size             Int                                                // bytes

  // Soft-remove fields
  isRemoved        Boolean   @default(false)
  removedReason    String?   @db.VarChar(500)                        // max 500 chars
  removedAt        DateTime?

  uploadedAt       DateTime  @default(now())

  // Foreign key
  ticketId         Int
  ticket           Ticket    @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Comment — Public Comments visible to Requester, IT Staff, Administrator (BR-04)
// ---------------------------------------------------------------------------

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.VarChar(2000)                               // max 2000 chars (BR-20)
  createdAt DateTime @default(now())

  // Foreign keys
  ticketId  Int
  authorId  Int

  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// InternalNote — visible only to IT Staff and Administrator (BR-04)
// ---------------------------------------------------------------------------

model InternalNote {
  id        Int      @id @default(autoincrement())
  content   String   @db.VarChar(2000)                               // max 2000 chars (BR-20)
  createdAt DateTime @default(now())

  // Foreign keys
  ticketId  Int
  authorId  Int

  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}
