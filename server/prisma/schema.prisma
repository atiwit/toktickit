// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW                    // ticket ถูกสร้างใหม่ (default)
  OPEN                   // ticket ถูกเปิดและรอดำเนินการ
  IN_PROGRESS            // ticket อยู่ระหว่างดำเนินการ
  WAITING_FOR_REQUESTER  // รอผู้ร้องขอตอบกลับ
  RESOLVED               // ticket ได้รับการแก้ไขแล้ว
  CLOSED                 // ticket ถูกปิด
  REOPENED               // ticket ถูกเปิดใหม่
  CANCELLED              // ticket ถูกยกเลิก
}

// ---------------------------------------------------------------------------
// Reference Data
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets   Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// User — replaces RequesterUser (Lab 3 migration)
// Supports Requester, IT Staff, and Administrator roles
// ---------------------------------------------------------------------------

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(REQUESTER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tickets            Ticket[]       @relation("TicketRequester")
  ownedTickets       Ticket[]       @relation("TicketOwner")
  comments           Comment[]
  internalNotes      InternalNote[]
}

// ---------------------------------------------------------------------------
// Ticket
// ---------------------------------------------------------------------------

model Ticket {
  id                Int          @id @default(autoincrement())
  ticketNumber      String       @unique                    // generated by backend (BR-01)
  status            TicketStatus @default(NEW)              // always starts as NEW (BR-01)
  requestedPriority Priority
  itPriority        Priority                                // initially copies requestedPriority (BR-13)

  summary           String       @db.VarChar(200)           // max 200 chars (BR-06)
  description       String       @db.VarChar(2000)          // max 2000 chars (BR-06)

  requesterResolved Boolean      @default(false)            // Requester indicates problem appears resolved

  // Foreign keys
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int
  ownerId           Int?                                    // nullable — ticket may be unassigned (BR-12)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  requester         User          @relation("TicketRequester", fields: [requesterId], references: [id])
  category          Category      @relation(fields: [categoryId], references: [id])
  relatedSystem     RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  owner             User?         @relation("TicketOwner", fields: [ownerId], references: [id])
  attachments       Attachment[]
  comments          Comment[]
  internalNotes     InternalNote[]

  // Indexes for common query patterns (BR-10)
  @@index([requesterId])
  @@index([ownerId])
  @@index([status])
  @@index([ticketNumber])
}

// ---------------------------------------------------------------------------
// Attachment — soft-delete only, never physically deleted (BR-13)
// ---------------------------------------------------------------------------

model Attachment {
  id               Int       @id @default(autoincrement())

  // File metadata
  originalFilename String                                   // original name kept as metadata (BR-15)
  storedFilename   String    @unique                        // UUID-based server filename (BR-15)
  mimeType         String
  size             Int                                      // bytes

  // Soft-remove fields (BR-13)
  isRemoved        Boolean   @default(false)
  removedReason    String?   @db.VarChar(500)               // max 500 chars (BR-13)
  removedAt        DateTime?

  uploadedAt       DateTime  @default(now())

  // Foreign key
  ticketId         Int
  ticket           Ticket    @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Comment — Public comments visible to Requester, IT Staff, Administrator (BR-04)
// Append-only in Lab 3 (BR-17)
// ---------------------------------------------------------------------------

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.VarChar(2000)                     // max 2000 chars (BR-20)
  ticketId  Int
  authorId  Int
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// InternalNote — visible only to IT Staff and Administrator (BR-04)
// Append-only in Lab 3 (BR-17)
// ---------------------------------------------------------------------------

model InternalNote {
  id        Int      @id @default(autoincrement())
  content   String   @db.VarChar(2000)                     // max 2000 chars (BR-20)
  ticketId  Int
  authorId  Int
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}
