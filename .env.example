# Database connection string for Prisma
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"

# Server Port
PORT=3000

# Runtime mode. Cloud Run uses "production"
# NODE_ENV=development

# First admin password for the seed. Required when NODE_ENV=production
# ADMIN_PASSWORD=change-me

# Demo users and sample tickets
# SEED_DEMO_DATA=false
# DEMO_USER_PASSWORD=change-me

# Allowed web origins, comma-separated (optional)
# CORS_ORIGIN=http://localhost:5173

# Client frontend API URL
# VITE_API_URL=http://localhost:3000
